diff --git a/src/routes.mjs b/src/routes.mjs
index 67da100a9ed0b37fbbdd5940b9e3287ab37a3bf4..2c00a56379fa9cbb4ccc9639ca725855997315ac 100644
--- a/src/routes.mjs
+++ b/src/routes.mjs
@@ -7,6 +7,7 @@ const fail = (status, error) => ({ status, body: { error } });
 const isObject = (v) => v !== null && typeof v === 'object' && !Array.isArray(v);
 
 export const validTitle = (t) => typeof t === 'string' && t.trim() !== '';
+const TAG = /^[a-z0-9-]{1,30}$/;
 
 export const routes = [
   ['GET', '/api/health', () => ok({ ok: true })],
@@ -17,11 +18,18 @@ export const routes = [
     if (!isObject(body)) return fail(400, 'invalid_body');
     if (!validTitle(body.title)) return fail(400, 'invalid_title');
     if (body.done !== undefined && typeof body.done !== 'boolean') return fail(400, 'invalid_done');
